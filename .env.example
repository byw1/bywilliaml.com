# Scheduling (/meet and /admin). Copy to .env.local for local development.
# The rest of the site runs fine without any of these.
# Full setup instructions: SCHEDULING.md

DATABASE_URL=postgresql://postgres@localhost:5432/scheduling

# openssl rand -base64 32
SCHEDULING_ENCRYPTION_KEY=
SCHEDULING_SESSION_SECRET=

# Google accounts allowed into /admin, comma-separated.
ADMIN_EMAILS=william@bywilliaml.com

# Absolute origin. OAuth redirect URIs are derived from this.
APP_URL=http://localhost:3000

# console.cloud.google.com — Calendar API + Meet API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# api-console.zoho.com — Server-based Application
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Set if the Zoho account lives outside the .com datacentre.
# ZOHO_ACCOUNTS_HOST=https://accounts.zoho.eu
